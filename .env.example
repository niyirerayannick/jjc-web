# ==============================================================================
# Jehovah Jireh Choir – ULK | Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# Django
SECRET_KEY=your-very-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# PostgreSQL connection string (use the Coolify internal URL in production)
DATABASE_URL=postgresql://jjc_user:strong-password@postgres-host:5432/jjc_db

# Optional one-time Coolify seed. Set false again after the first successful deploy.
RUN_SEED_ON_DEPLOY=false
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Jehovah Jireh Choir <noreply@jjculk.rw>

# Media / Storage
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Site
SITE_URL=https://example.com

# TinyMCE API Key (get from tiny.cloud)
TINYMCE_API_KEY=your-tinymce-api-key

# Redis (optional – for caching/celery)
REDIS_URL=redis://localhost:6379/0
