# ==============================================================================
# Jehovah Jireh Choir – ULK | Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to Git.
# ==============================================================================

# Django
SECRET_KEY=your-very-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=jjc_db
DB_USER=jjc_user
DB_PASSWORD=jjc_password
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Jehovah Jireh Choir <noreply@jjculk.rw>

# Media / Storage
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# Site
SITE_URL=http://localhost:8000

# TinyMCE API Key (get from tiny.cloud)
TINYMCE_API_KEY=your-tinymce-api-key

# Redis (optional – for caching/celery)
REDIS_URL=redis://localhost:6379/0
